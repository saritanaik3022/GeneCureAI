# Environment Configuration for Gene-Cure AI Platform

# Application Settings
APP_NAME=Gene-Cure AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_1234567890abcdef

# Execution Mode: DEMO_MODE or REAL_MODE
EXECUTION_MODE=REAL_MODE

# Database Configuration (PostgreSQL with SQLite local dev fallback)
DATABASE_URL=sqlite+aiosqlite:///./gene_cure_ai.db

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Real Biological Dataset Paths (Configurable via Environment)
DATA_ROOT=C:/Users/GeneCureAI/data
GENOME_FASTA=C:/Users/GeneCureAI/data/genome/GRCh38.primary_assembly.genome.fa
GENCODE_GTF=C:/Users/GeneCureAI/data/annotation/gencode.v46.annotation.gtf
BOWTIE2_INDEX=C:/Users/GeneCureAI/data/bowtie2_index/GRCh38
DOENCH_DATA=C:/Users/GeneCureAI/data/doench2016/doench2016_ruleset2_train.csv
CANCER_RELEVANCE_DATA=C:/Users/GeneCureAI/results/cancer_relevance_scores.csv

# Legacy / Alternative paths
GRCH38_FASTA_PATH=C:/Users/GeneCureAI/data/genome/GRCh38.primary_assembly.genome.fa
GRCH38_BOWTIE2_INDEX=C:/Users/GeneCureAI/data/bowtie2_index/GRCh38
BLAST_DB_PATH=./data/references/blast_db/GRCh38

# ML Model Checkpoints
CNN_MODEL_WEIGHTS_PATH=./ml/models/cnn_best_weights.pt
XGBOOST_MODEL_PATH=./ml/models/xgb_105_model.json
ENSEMBLE_MODEL_PATH=./ml/models/ensemble_meta_learner.joblib

# Logging
LOG_LEVEL=INFO
